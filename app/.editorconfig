# .editorconfig
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Базовый стиль — Android Kotlin Style Guide
ktlint_code_style = android_studio

# Длина строки. 120 — компромисс между читаемостью и шириной экрана.
# В Android Studio style по умолчанию 100, но на практике 120 удобнее для Compose.
max_line_length = 120

# Compose: @Composable-функции по конвенции пишутся в PascalCase.
# Это официальная рекомендация ktlint — исключаем их из правила function-naming.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Тестовые функции тоже могут иметь длинные имена — исключаем @Test.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test

# Разрешаем trailing comma (важно для чистых diff'ов в Kotlin)
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true